<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="12.0" maxWidth="320.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">
    <children>
        <Label text="Login" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <TextField fx:id="usernameField" promptText="Username" onAction="#login" />
        <PasswordField fx:id="passwordField" promptText="Password" onAction="#login" />
        <Button fx:id="loginButton" text="Log In" defaultButton="true" onAction="#login" />
        <Label fx:id="errorLabel" style="-fx-text-fill: #c62828;" wrapText="true" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
