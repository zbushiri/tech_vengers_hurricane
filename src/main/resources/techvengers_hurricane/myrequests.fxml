<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- My requests page. @author nate sheffield -->
<StackPane fx:id="root" prefHeight="600.0" prefWidth="960.0"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.MyRequestsController">
    <stylesheets>
        <URL value="@rolehome.css" />
        <URL value="@pages.css" />
    </stylesheets>
    <BorderPane styleClass="rh-root">
        <left>
            <fx:include source="sidebar.fxml" />
        </left>
        <center>
            <VBox>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="rh-header">
                    <VBox>
                        <Label fx:id="eyebrowLabel" styleClass="rh-eyebrow" />
                        <Label fx:id="titleLabel" text="My requests" styleClass="rh-title" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="headerButton" visible="false" managed="false" styleClass="rh-btn-primary" />
                    <Label fx:id="userLabel" styleClass="pg-name" />
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="pg-scroll">
                    <VBox fx:id="body" spacing="18.0" styleClass="pg-body" />
                </ScrollPane>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
