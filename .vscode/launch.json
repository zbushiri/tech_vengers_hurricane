{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "UI",
      "request": "launch",
      "mainClass": "model.UI",
      "projectName": "hurricanejavafx",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--enable-native-access=javafx.graphics"
    },
    {
      "type": "java",
      "name": "MapUI",
      "request": "launch",
