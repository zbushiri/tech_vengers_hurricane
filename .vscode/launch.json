      "projectName": "hurricanejavafx",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--enable-native-access=javafx.graphics"
    },
    {
      "type": "java",
      "name": "TestUI",
      "request": "launch",
      "mainClass": "model.TestUI",
      "projectName": "hurricanejavafx",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--enable-native-access=javafx.graphics"
    },
    {
      "type": "java",
      "name": "Scenario",
      "request": "launch",
      "mainClass": "model.ScenarioUI",
      "projectName": "hurricanejavafx",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "vmArgs": "--enable-native-access=javafx.graphics"
    },
    {
